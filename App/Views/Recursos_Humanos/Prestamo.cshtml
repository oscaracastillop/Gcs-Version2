
@{
    ViewBag.Title = "Préstamo";
}

<h6>MODULO PRESTAMO</h6>

<div class="grid">
    <table id="gridPrestamoEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalPrestamoEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalPrestamoEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdPrestamoEmpleado" hidden></label>
                <div>
                    <label><strong>Empleado</strong><label style="color:red" id=""> *</label></label>
                    <select class="form-control" id="SelectContratoLaboralSucursalEmpleado" style="min-width:100%"></select>
                </div>
                <div class="row">
                    <div class="col-8">
                        <label><strong>Valor</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputPrestamoEmpleadoValor" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-4">
                        <label><strong>Cuotas</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputPrestamoEmpleadoNumeroCuotas" name="name" autocomplete="off" style="min-width:100%" value="1" disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label><strong>Fecha Préstamo</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputPrestamoEmpleadoFechaPrestamo" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Cobro</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputPrestamoEmpleadoFechaPago" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>
                <div>
                    <label><strong>Observación</strong></label>
                    <input class="form-control" type="text" id="InputPrestamoEmpleadoObservacion" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="col-3" id="SelectEstadoPrestamoEmpleado">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
                <br />
                <label style="color: red">Los campos con * son obligatorios</label>
            </div>

            <div class="modal-footer" id="BotonesModalPrestamoEmpleado">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Prestamo');
        ListaContratoLaboralSucursalEmpleado();
        GridPrestamoEmpleado();
        ListaTipoEstado(1);
    });
</script>