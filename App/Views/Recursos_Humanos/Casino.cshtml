
@{
    ViewBag.Title = "Casino";
}

<h6>MODULO CASINO</h6>

<div class="grid">
    <table id="gridCasinoEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalCasinoEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalCasinoEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdCasinoEmpleado" hidden></label>
                <div class="row">
                    <div class="col-7">
                        <label><strong>Empleado</strong><label style="color:red" id=""> *</label></label>
                        <select class="form-control" id="SelectContratoLaboralSucursalEmpleado" style="min-width:100%"></select>
                    </div>
                    <div class="col-5">
                        <label><strong>Valor</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputCasinoEmpleadoValor" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <label><strong>Fecha Pedido</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputCasinoEmpleadoFecha" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Cobro</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputCasinoEmpleadoFechaPago" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>
                <div>
                    <label><strong>Observación</strong></label>
                    <input class="form-control" type="text" id="InputCasinoEmpleadoObservacion" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="col-3" id="SelectEstadoCasinoEmpleado">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
                <br />
                <label style="color: red">Los campos con * son obligatorios</label>
            </div>

            <div class="modal-footer" id="BotonesModalCasinoEmpleado">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Casino');
        ListaContratoLaboralSucursalEmpleado();
        GridCasinoEmpleado();
        ListaTipoEstado(1);
    });
</script>