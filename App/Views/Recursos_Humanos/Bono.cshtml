
@{
    ViewBag.Title = "Bono";
}

<h6>Módulo Bono</h6>

<div class="grid">
    <table id="gridBonoEmpleado" class="table cell-border" cellspacing="0" style="width: 150%;"></table>
</div>

<div class="modal fade" id="ModalBonoEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalBonoEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdBonoEmpleado" hidden></label>
                <div>
                    <label><strong>Empleado</strong><label style="color:red" id=""> *</label></label>
                    <select class="form-control" id="SelectContratoLaboralSucursalEmpleado" style="min-width:100%"></select>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label><strong>Valor</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputBonoEmpleadoValor" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Pago</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputBonoEmpleadoFechaPago" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>
                <div>
                    <label><strong>Observación</strong></label>
                    <input class="form-control" type="text" id="InputBonoEmpleadoObservacion" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="col-3" id="SelectEstadoBonoEmpleado">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
                <br />
                <label style="color: red">Los campos con * son obligatorios</label>
            </div>

            <div class="modal-footer" id="BotonesModalBonoEmpleado">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Bono');
        ListaContratoLaboralSucursalEmpleado();
        GridBonoEmpleado();
        ListaTipoEstado(1);
    });
</script>