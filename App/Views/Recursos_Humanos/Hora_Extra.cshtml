
@{
    ViewBag.Title = "Hora Extra";
}


<script src="~/JsApp/Empleado.js"></script>
<script src="~/JsApp/HoraExtraEmpleado.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>
<script src="~/JsApp/TipoHoraExtra.js"></script>


<div class="tituloPage">
    <label>MODULO HORAS EXTRAS</label>
</div>



<div class="grid">
    <table id="gridHoraExtraEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>


<!-- Modal Otros Ingresos -->
<div class="modal fade" id="ModalHoraExtraEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalHoraExtraEmpleado"></div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3" style="background-color: #f8f9fa;">
                <label id="LabelIdHoraExtraEmpleado" hidden></label>

                <div class="row g-2">
                    <div>
                        <label><strong>Empleado</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <select class="form-control" id="SelectContratoLaboralEmpleado"></select>
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Tipo Hora Extra</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-stack"></i></span>
                            <select class="form-control" id="SelectTipoHoraExtra"></select>
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Cantidad</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-123"></i></span>
                            <input class="form-control" type="number" id="InputCantidadHEEmpleado" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Fecha Hora Extra</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-calendar3"></i></span>
                            <input class="form-control" type="date" id="InputFechaHEEmpleado" maxlength="13" placeholder="(ind ciudad) + # Telefónico" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Pago Hora Extra</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-calendar3"></i></span>
                            <input class="form-control" type="date" id="InputFechaPagoHEEmplado" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Observación</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-earmark-text"></i></span>
                            <input class="form-control" type="text" id="InputHEEmpleadoObservacion" />
                        </div>
                    </div>
                    <div class="col-3" id="SelectEstadoHoraExtraEmpleado">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light py-2" id="BotonesModalHoraExtraEmpleado"></div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Hora_Extra');
        GridHoraExtraEmpleado();
        ListaTipoEstado(1);
        ListaContratoLaboralEmpleado();
        ListaTipoHoraExtra();
    });
</script>