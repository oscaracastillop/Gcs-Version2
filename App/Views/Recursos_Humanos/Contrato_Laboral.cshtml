
@{
    ViewBag.Title = "Contrato Laboral";
}

<script src="~/JsApp/Banco.js"></script>
<script src="~/JsApp/Cargo.js"></script>
<script src="~/JsApp/CCFamiliar.js"></script>
<script src="~/JsApp/ContratoLaboral.js"></script>
<script src="~/JsApp/Empleado.js"></script>
<script src="~/JsApp/Sucursal.js"></script>
<script src="~/JsApp/Eps.js"></script>
<script src="~/JsApp/FondoCesantias.js"></script>
<script src="~/JsApp/FondoPensiones.js"></script>
<script src="~/JsApp/TipoContrato.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>

<h6>MODULO CONTRATO LABORAL</h6>

<div class="grid">
    <table id="gridCLE" class="table nowrap cell-border table-striped" style="width: 100%;"></table>
</div>



<!-- Modal Contrato Laboral-->
<div class="modal fade" id="ModalCLE" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalCLE"></div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdCLE" hidden></label>

                <div>
                    <div class="contimg-cambiar-img" id="ImagenEmpleado">
                        <img class="imagen-escalada-cambiar" src="~/Images/ImagenHVEmpleado/Empleado.png" />
                    </div>
                </div>

                <div class="row g-2">
                    <div>
                        <label><strong>Empleado</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <select class="form-control" id="SelectEmpleado" onchange="CargarDatosCLE($('#SelectEmpleado').val())"></select>
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Fecha Inicio Contrato</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-calendar3"></i></span>
                            <input class="form-control" type="date" id="InputFechaInicioCLE" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Fin Contrato</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-calendar3"></i></span>
                            <input class="form-control" type="date" id="InputFechaFinCLE" autocomplete="off" disabled />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Sucursal</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-house-gear"></i></span>
                            <select class="form-control" id="SelectSucursal"></select>
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Cargo</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person-badge"></i></span>
                            <select class="form-control" id="SelectCargo"></select>
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Contrato</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <select class="form-control" id="SelectTipoContrato"></select>
                        </div>
                    </div>
                    <div class="col-3">
                        <label><strong>Salario Mensual</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-coin"></i></span>
                            <input class="form-control" type="number" id="InputSalarioCLE" autocomplete="off" onchange="CalcularValorDia()" placeholder="0" />
                        </div>
                    </div>
                    <div class="col-3">
                        <label><strong>Valor Día</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-coin"></i></span>
                            <input class="form-control" type="text" id="InputValorDiaSalarioCLE" placeholder="0" disabled />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-4">
                        <label><strong>SubTransporte Mensual</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-coin"></i></span>
                            <input class="form-control" type="number" id="InputSubTransporteCLE" autocomplete="off" placeholder="0" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Banco</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-bank"></i></span>
                            <select class="form-control" id="SelectBanco"></select>
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong># Cuenta Pago</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-123"></i></span>
                            <input class="form-control" type="number" id="InputNumeroCuentaPagoCLE" placeholder="0" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-3">
                        <label><strong>Eps</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-hospital"></i></span>
                            <select class="form-control" id="SelectEps"></select>
                        </div>
                    </div>
                    <div class="col-3">
                        <label><strong>% Contri.</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-percent"></i></span>
                            <input class="form-control" type="number" id="InputPorcentajeContribucionEpsCLE" autocomplete="off" placeholder="0" />
                        </div>
                    </div>
                    <div class="col-3">
                        <label><strong>Fondo Pensión</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-universal-access-circle"></i></span>
                            <select class="form-control" id="SelectFondoPensiones"></select>
                        </div>
                    </div>
                    <div class="col-3">
                        <label><strong>% Contri.</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-percent"></i></span>
                            <input class="form-control" type="number" id="InputPorcentajeContribucionFPCLE" autocomplete="off" placeholder="0" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-3">
                        <label><strong>Fondo Cesantías</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-universal-access"></i></span>
                            <select class="form-control" id="SelectFondoCesantias"></select>
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Observación</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-earmark-text"></i></span>
                            <input class="form-control" type="text" id="InputObservacionCLE" />
                        </div>
                    </div>
                    <div class="col-3" id="SelectEstadoCLE">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2" id="BotonesModalCLE"></div>
        </div>
    </div>
</div>


<!-- Modal Finalizar Contrato Laboral-->
<div class="modal fade" id="ModalFinalizarCLE" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title">FINALIZAR CONTRATO LABORAL</div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdFinalizarCLE" hidden></label>

                <div class="row g-2">
                    <div>
                        <label><strong>Empleado</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <input class="form-control" type="text" id="NombreEmpleado" autocomplete="off" disabled />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Fecha Inicio Contrato</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-calendar3"></i></span>
                            <input class="form-control" type="date" id="InputFechaInicioFinalizarCLE" disabled />
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Fin Contrato</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-calendar3"></i></span>
                            <input class="form-control" type="date" id="InputFechaFinFinalizarCLE" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-modal-Cancelar" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                <button type="button" class="btn btn-sm btn-modal-guardar" onclick="FinalizarCLE()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Documentos Contrato Laboral-->
<div class="modal fade" id="ModalDocCLE" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title">DESCARGAR DOCUMENTOS</div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdDocCLE" hidden></label>

                <div class="row g-2">
                    <div>
                        <label><strong>Empleado</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <input class="form-control" type="text" id="NombreDocCLEEmpleado" autocomplete="off" disabled />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div>
                        <label><strong>Documento Pdf</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <select id="SelectDocCLE" class="form-control">
                                <option value="-1">- Escoge un documento -</option>
                                <option value="1">Contrato laboral</option>
                                <option value="2">Certificado laboral</option>
                                <option value="3">Paz y Salvo</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-sm btn-modal-Cancelar" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                <button type="button" class="btn btn-sm btn-modal-guardar" onclick="DescargarDocCLE()">Descargar</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Contrato_Laboral');
        GridCLE();
        ListaEmpleado();
        ListaCargo();
        ListaTipoEstado(1);
        ListaTipoContrato();
        ListaEps();
        ListaFondoPensiones();
        ListaFondoCesantias();
        ListaBanco();
        ListaSucursal();
    });
</script>