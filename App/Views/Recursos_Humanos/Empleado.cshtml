
@{
    ViewBag.Title = "Empleado";
}

<script src="~/JsApp/Ciudad.js"></script>
<script src="~/JsApp/Empleado.js"></script>
<script src="~/JsApp/TipoDocumento.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>


<div class="tituloPage">
    <label>MODULO EMPLEADO</label>
</div>



<div class="grid">
    <table id="gridEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>


<!-- Modal Empresa-->
<div class="modal fade" id="ModalEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalEmpleado"></div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdEmpleado" hidden></label>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Nombres</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <input class="form-control" type="text" id="InputNombreEmpleado" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Apellidos</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <input class="form-control" type="text" id="InputApellidosEmpleado" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Documento</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-card-text"></i></span>
                            <select class="form-control" id="SelectTipoDocumento"></select>
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Identificación</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person-vcard"></i></span>
                            <input class="form-control" type="text" id="InputIdentificacionEmpleado" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Ciudad Expedición</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-geo"></i></span>
                            <select class="form-control" id="SelectCiudad"></select>
                        </div>
                    </div>
                    <div class="col-3" id="SelectEstadoEmpleado">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2" id="BotonesModalEmpleado"></div>
        </div>
    </div>
</div>

<!-- Modal ImagenEmpleado-->
<div class="modal fade" id="ModalImagenEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="modal-header header-modal">
                <label class="modal-title fw-bold mb-0">FOTO EMPLEADO</label>
            </div>

            <!-- Hidden labels -->
            <label id="IdEmpleadoImagen" hidden></label>
            <label id="NombreImagenActualEmpleado" hidden></label>

            <!-- Body -->
            <div class="modal-body bg-light p-4">
                <!-- Nombre empleado -->
                <div class="text-center mb-4">
                    <h5 class="fw-bold text-primary mb-0" id="NombreEmpleadoImagen"></h5>
                </div>

                <!-- Contenedor de columnas -->
                <div class="row g-4">
                    <!-- Imagen actual -->
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100 border border-2 border-light">
                            <div class="card-header text-white fw-semibold py-2" style="background-color: #3b5998;">
                                Imagen actual
                            </div>
                            <div class="card-body text-center d-flex align-items-center justify-content-center pb-3">
                                <div class="contimg-cambiar-img" id="ImagenHVEmpleado"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Nueva imagen -->
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100 border border-2 border-light">
                            <div class="card-header text-white fw-semibold py-2" style="background-color: #3b5998;">
                                Subir nueva imagen
                            </div>
                            <div class="card-body d-flex flex-column justify-content-center">
                                <div>
                                    <input type="file" class="form-control mb-3" id="inPhoto"
                                           name="name" accept="image/*"
                                           aria-describedby="inputGroupFileAddon04"
                                           aria-label="Upload">
                                </div>
                                <!-- Previsualización -->
                                <div id="previewContainer" class="text-center d-none">
                                    <p class="fw-semibold mb-2">Vista previa:</p>
                                    <img id="previewImage" class="img-fluid rounded shadow-sm border preview-img" alt="Vista previa">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light border-0 p-3 d-flex justify-content-between">
                <button type="button" class="btn btn-modal-Cancelar btn-sm" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-modal-guardar btn-sm" type="button" onclick="GuardarImagenHVEmpleado()">
                    Guardar Imagen
                </button>
            </div>
        </div>
    </div>
</div>


<style>
</style>

<script>
    // Previsualización de la nueva imagen
    document.getElementById("inPhoto").addEventListener("change", function (event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById("previewContainer");
        const previewImage = document.getElementById("previewImage");

        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove("d-none");
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add("d-none");
            previewImage.src = "";
        }
    });
</script>


<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Empleado');
        GridEmpleado();
        ListaTipoDocumento(1);
        ListaTipoEstado(1);
        ListaCiudad();
    });
</script>