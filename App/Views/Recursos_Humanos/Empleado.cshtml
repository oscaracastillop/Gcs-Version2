
@{
    ViewBag.Title = "Empleado";
}

<script src="~/JsApp/Ciudad.js"></script>
<script src="~/JsApp/Empleado.js"></script>
<script src="~/JsApp/TipoDocumento.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>


<div class="tituloPage">
    <label>MODULO EMPLEADO</label>
</div>



<div class="grid">
    <table id="gridEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<!-- Modal Empleado-->
<div class="modal fade" id="ModalEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdEmpleado" hidden></label>
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Nombres </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="text" id="InputNombreEmpleado" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Apellidos </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="text" id="InputApellidosEmpleado" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Documento </strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectTipoDocumento" style="min-width:100%"></select>
                    </div>
                    <div class="col-6">
                        <label><strong>Identificación </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="text" id="InputIdentificacionEmpleado" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Ciudad Expedición </strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectCiudad" style="min-width:100%"></select>
                    </div>
                </div>

                <div class="col-3" id="SelectEstadoEmpleado">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
            </div>
            <div class="modal-footer" id="BotonesModalEmpleado">
            </div>
        </div>
    </div>
</div>

<!-- Modal ImagenEmpleado-->
<div class="modal fade" id="ModalImagenEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="modal-header header-modal">
                <label class="modal-title fw-bold mb-0">FOTO EMPLEADO</label>
            </div>

            <!-- Hidden labels -->
            <label id="IdEmpleadoImagen" hidden></label>
            <label id="NombreImagenActualEmpleado" hidden></label>

            <!-- Body -->
            <div class="modal-body bg-light p-4">
                <!-- Nombre empleado -->
                <div class="text-center mb-3">
                    <h6 class="fw-bold mb-0" id="NombreEmpleadoImagen"></h6>
                </div>

                <!-- Imagen actual -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header text-white fw-semibold py-2" style="background-color: #3b5998;">
                        Imagen actual
                    </div>
                    <div class="card-body text-center">
                        <div class="contimg-cambiar-img" id="ImagenHVEmpleado"></div>
                        <a href="#" class="d-block mt-2 small text-decoration-none text-primary">Ver Información Empleado</a>
                    </div>
                </div>

                <!-- Nueva imagen -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header text-white fw-semibold py-2" style="background-color: #3b5998;">
                        Subir nueva imagen
                    </div>
                    <div class="card-body">
                        <input type="file" class="form-control mb-3" id="inPhoto"
                               name="name" accept="image/*"
                               aria-describedby="inputGroupFileAddon04"
                               aria-label="Upload">
                        <!-- Previsualización -->
                        <div id="previewContainer" class="text-center d-none">
                            <p class="fw-semibold">Vista previa:</p>
                            <img id="previewImage" class="img-fluid rounded shadow-sm border" alt="Vista previa">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light border-0 p-3 d-flex justify-content-between">
                <button type="button" class="btn btn-modal-Cancelar btn-sm" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-modal-guardar btn-sm" type="button" onclick="GuardarImagenHVEmpleado()">
                    Guardar Imagen
                </button>
            </div>
        </div>
    </div>
</div>

<style>
 
</style>

<script>
    // Previsualización de la nueva imagen
    document.getElementById("inPhoto").addEventListener("change", function (event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById("previewContainer");
        const previewImage = document.getElementById("previewImage");

        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove("d-none");
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add("d-none");
            previewImage.src = "";
        }
    });
</script>


<script>
    $(document).ready(function () {
        ValidarSesion('/Recursos_Humanos/Empleado');
        GridEmpleado();
        ListaTipoDocumento(1);
        ListaTipoEstado(1);
        ListaCiudad();
    });
</script>