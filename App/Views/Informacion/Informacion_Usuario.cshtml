
@{
    ViewBag.Title = "Información Usuario";
}

<script src="~/JsApp/Usuario.js"></script>

<div class="tituloPage">
    <label>MODULO INFORMACION USUARIO</label>
</div>
<br />
<table class="" width="300">
    <tr>
        <td>
            <span><strong>Propietario de la Cuenta:</strong></span>
        </td>
        <td>
            <label id="NombreUsuario"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Usuario Login:</strong></span>
        </td>
        <td>
            <label id="NombreUserLogin"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Email:</strong></span>
        </td>
        <td>
            <label id="EmailUserLogin"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Fecha Último Ingreso:</strong></span>
        </td>
        <td>
            <label id="FechaUltimoIngresoUser"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Fecha Creación:</strong></span>
        </td>
        <td>
            <label id="FechaCreadoUser"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Fecha Vigencia:</strong></span>
        </td>
        <td>
            <label id="FechaVigenciaUser"></label>
        </td>
    </tr>
</table>
<br />
<button class="btn btn-modal-guardar btn-sm" type="button" onclick="ModalActualizarPass()">Cambiar Contraseña</button>

<br />
<br />
<div class="tituloPage">
    <label>MODULOS ACTIVOS DEL USUARIO</label>
</div>
<div style="text-align:justify" id="ModulosActivosUsuario"></div>


<!-- Modal Banco-->
<div class="modal fade" id="ModalActualizarPass" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalActualizarPass"></div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdBanco" hidden></label>

                <div class="row g-2">
                    <div class="col-4">
                        <label><strong>Contraseña Actual</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-key"></i></span>
                            <input class="form-control" type="text" id="PasswordActual" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Nueva Contraseña</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-key"></i></span>
                            <input class="form-control" type="text" id="PasswordNuevo" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Confirmar Contraseña</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-key-fill"></i></span>
                            <input class="form-control" type="text" id="PasswordNuevoConfirmar" autocomplete="off" />
                        </div>
                    </div>
                </div>
            </div>
            <!-- Footer -->
            <div class="modal-footer py-2" id="BotonesModalActualizarPass"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Informacion/Informacion_Usuario');
        InformacionUsuario();
        UltimoIngresoUsuario();
        ModulosActivosUsuario();
    });
</script>
