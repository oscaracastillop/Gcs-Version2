
@{
    ViewBag.Title = "Información Usuario";
}

<script src="~/JsApp/Usuario.js"></script>

<div class="tituloPage">
    <label>MODULO INFORMACION USUARIO</label>
</div>
<br />
<table class="" width="300">
    <tr>
        <td>
            <span><strong>Propietario de la Cuenta:</strong></span>
        </td>
        <td>
            <label id="NombreUsuario"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Usuario Login:</strong></span>
        </td>
        <td>
            <label id="NombreUserLogin"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Email:</strong></span>
        </td>
        <td>
            <label id="EmailUserLogin"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Fecha Último Ingreso:</strong></span>
        </td>
        <td>
            <label id="FechaUltimoIngresoUser"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Fecha Creación:</strong></span>
        </td>
        <td>
            <label id="FechaCreadoUser"></label>
        </td>
    </tr>
    <tr>
        <td>
            <span><strong>Fecha Vigencia:</strong></span>
        </td>
        <td>
            <label id="FechaVigenciaUser"></label>
        </td>
    </tr>
</table>
<br />
<button class="btn btn-modal-guardar btn-sm" type="button" onclick="ModalActualizarPass()">Cambiar Contraseña</button>

<br />
<br />
<div class="tituloPage">
    <label>MODULOS ACTIVOS DEL USUARIO</label>
</div>
<div style="text-align:justify" id="ModulosActivosUsuario"></div>




<div class="modal fade" id="ModalActualizarPass" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalActualizarPass"></div>
            </div>
            <div class="modal-body">
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Contraseña Actual </strong><label style="font-size:9px!important; color:red"> *</label></label>
                        <input class="form-control" type="text" name="name" value="" id="PasswordActual" autocomplete="off" style="min-width:100%!important" />
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Nueva Contraseña </strong><label style="font-size:9px!important; color:red"> *</label></label>
                        <input class="form-control" type="text" name="name" value="" id="PasswordNuevo" autocomplete="off" style="min-width:100%!important" />
                    </div>
                    <div class="col-6">
                        <label><strong>Confirmar Contraseña </strong><label style="font-size:9px!important; color:red"> *</label></label>
                        <input class="form-control" type="text" name="name" value="" id="PasswordNuevoConfirmar" autocomplete="off" style="min-width:100%!important" />
                    </div>
                </div>
            </div>
            <div class="modal-footer" id="BotonesModalActualizarPass"></div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        ValidarSesion('/Informacion/Informacion_Usuario');
        InformacionUsuario();
        UltimoIngresoUsuario();
        ModulosActivosUsuario();
    });
</script>
