<!-- Modal Datos Cliente-->
<div class="modal fade" id="ModalAyuda" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title">Ayuda</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="card grid">
                    <label><strong>Estados</strong></label>
                    <ul>
                        <li>
                            <label><i class="bi-circle-fill" style="color: green"></i> Activo: El registro se encuentra activo o disponible para ser usado.</label>                            
                        </li>
                        <li>
                            <label><i class="bi-circle-fill" style="color: red"></i> Inactivo: El registro se encuentra inactivo o no está disponible para ser usado.</label>
                        </li>
                    </ul>  
                </div>
                <br />
                <div class="card grid" style="padding:10px">
                    <label><strong>Acciones</strong></label>
                    <ul>
                        <li>
                            <label><i class="bi-pencil-fill" style="color: black"></i> Editar: Permite editar o actualizar datos del resgistro seleccionado.</label>
                        </li>
                        <li>
                            <label><i class="bi-trash-fill" style="color: red"></i> Eliminar: Elimina todos lod datos del registro seleccionado.</label>
                        </li>
                        <li>
                            <label><label style="background:green; font-size:7px; padding:2px; color:white">Nuevo</label> Nuevo: Crea un registro nuevo en la base de datos..</label>
                        </li>
                        <li>
                            <label>Dependiendo de los permisos que tenga el <strong>Usuario</strong> podra realizar dichas acciones.</label>
                        </li>
                    </ul>
                </div>


            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        reducirTamaño(100);

        if (TokenUser == '' || TokenUser == undefined || TokenUser == null) {
            Swal.fire({
                title: TituloSwal,
                text: "Su Sesión ya expiro, por favor vuelva a Ingresar",
                icon: 'info',
            }).then((result) => {
                window.location.href = '/Login';
            })
        } else {
            ListaMenu();
        }
        $('#NameApp').text(NameApp);
        $('#SloganEmpresa').text(SloganEmpresa);
    });

    function CerrarSesion() {
        Cookies.remove('TokenUser');
        window.location.href = '/Login';
    }

    function reducirTamaño(porcentaje) {
        // Calcula el nuevo factor de zoom.
        const factorZoom = porcentaje / 100;
        // Obtiene el elemento HTML.
        const html = document.documentElement;
        // Establece el zoom del elemento HTML.
        html.style.zoom = factorZoom;
    }

    // Ejemplo: Reducir el tamaño a un 90%

    function ModalAyuda() {
        $('#ModalAyuda').modal('show');
    }

</script>

