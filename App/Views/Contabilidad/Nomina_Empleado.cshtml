
@{
    ViewBag.Title = "Nómina Empleado";
}

<h6>Módulo Nómina Empleado</h6>

<div class="grid">
    <table id="gridNominaEmpleado" class="table cell-border" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalNominaEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalNominaEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdNominaEmpleado" hidden></label>
                <div style="text-align:left; margin-bottom:10px">
                    <label><strong>PERIODO DE NÓMINA</strong></label>
                </div>
                <div class="row">
                    <div class="col-2">
                        <label><strong>Fecha Inicio</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputNominaEmpleadoFechaInicio" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-2">
                        <label><strong>Fecha Fin</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputNominaEmpleadoFechaCorte" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-2">
                        <label><strong>Días a Pagar</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoDiasPagar" name="name" autocomplete="off" style="min-width:100%" placeholder="0" />
                    </div>
                    <div class="col-4">
                        <label><strong>Empleado</strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectContratoLaboralSucursalEmpleado" style="min-width:100%"></select>
                    </div>
                    <div class="col-2">
                        <br />
                        <a style="height:30px!important; font-size:11px!important; line-height:20px!important" class="btn btn-modal-Cancelar btn-sm" onclick="CargarDatosEmpleadoNomina()">Buscar</a>
                    </div>
                </div>
                <div class="row">
                    
                    <div class="col-6">
                        <label><strong>Empresa/Sucursal</strong></label>
                        <input class="form-control" type="text" id="txtEmpresaNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-3">
                        <label><strong>Salario Mensual</strong></label>
                        <input class="form-control" type="text" id="txtSalarioNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    
                </div>
                <div class="col-3" id="SelectEstadoNominaEmpleado">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
                <hr />
                <div style="text-align:left; margin-bottom:10px">
                    <label><strong>INGRESOS</strong></label>
                </div>
                <div class="row">
                    <div class="col-2">
                        <label><strong>Sueldo</strong></label>
                        <input class="form-control" type="text" id="txtSueldoaPagarNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>Aux Transporte</strong></label>
                        <input class="form-control" type="text" id="txtAuxTransporteNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>HE Diurna</strong></label>
                        <input class="form-control" type="text" id="txtHEDiurnaNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>HE Nocturna</strong></label>
                        <input class="form-control" type="text" id="txtHENocturnaNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>HE Diurna D/F</strong></label>
                        <input class="form-control" type="text" id="txtHEDiurnaDFNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>HE Nocturna D/F</strong></label>
                        <input class="form-control" type="text" id="txtHENocturnaDFNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                </div>
                <div class="row">
                    <div class="col-2">
                        <label><strong>Bonos</strong></label>
                        <input class="form-control" type="text" id="txtBonosNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>Préstamos</strong></label>
                        <input class="form-control" type="text" id="txtPrestamosINominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                </div>
                <div>
                    <div style="float:right">
                        <label><strong>Total Ingresos: <label id="txtTotalIngresosNominaEmpleado"></label></strong></label>
                    </div>
                </div>

                <div style="clear:both"></div>

                <hr />
                <div style="text-align:left; margin-bottom:10px">
                    <label><strong>DESCUENTOS</strong></label>
                </div>
                <div class="row">
                    <div class="col-2">
                        <label><strong>Eps</strong></label>
                        <input class="form-control" type="text" id="txtEpsNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>Pensión</strong></label>
                        <input class="form-control" type="text" id="txtPensionNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>Casino</strong></label>
                        <input class="form-control" type="text" id="txtCasinoNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>Préstamos</strong></label>
                        <input class="form-control" type="text" id="txtPrestamosDNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-2">
                        <label><strong>Novedades</strong></label>
                        <input class="form-control" type="text" id="txtNovedadesNominaEmpleado" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                </div>
                <div>
                    <div style="float:right">
                        <label><strong>Total Descuentos: <label id="txtTotalDescuentosNominaEmpleado"></label></strong></label>
                    </div>
                </div>
                <br />
                <div style="clear:both"></div>
                <br />
                <div>
                    <div style="float:right">
                        <label style="font-size:15px"><strong>Total a Pagar: <label id="txtTotalPagoNominaEmpleado"></label></strong></label>
                    </div>
                </div>
                <br />
                <div>
                    <ul>
                        <li><label style="color: red">Los campos con * son obligatorios.</label></li>
                        <li>En el campo <strong>Empleado</strong> encontrará los empleados que tengan un <strong>Contrato Laboral Activo o vigente</strong>.</li>
                        <li>Tenga presente que previamente debe ingresar los datos de <strong>Ingresos Adicionales (bonificaciones, préstamos, horas extras), Descuentos Adicionales (Casino, Préstamos, descuentos por días no laborados)</strong>, el sistema tendra en cuenta la fecha de Inicio y Fin para calcular la nómina correspondiente al Empleado seleccionado.</li>
                    </ul>
                </div>
            </div>
            <div class="modal-footer" id="BotonesModalNominaEmpleado">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Contabilidad/Nomina_Empleado');
        //GridNominaEmpleado();
        ListaTipoEstado(1);
        ListaContratoLaboralSucursalEmpleado();
        ModalNominaEmpleado('C');

    });
</script>