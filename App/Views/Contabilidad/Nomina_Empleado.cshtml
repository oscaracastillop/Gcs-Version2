
@{
    ViewBag.Title = "Nómina Empleado";
}

<h6>Módulo Nómina Empleado</h6>
<hr />

<div class="grid">
    <table id="gridNominaEmpleado" class="table cell-border" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalNominaEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalNominaEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdNominaEmpleado" hidden></label>
                <div class="row">
                    <div class="col-8">
                        <label><strong>Empleado</strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectContratoLaboralSucursalEmpleado" style="min-width:100%"></select>
                    </div>
                    <div class="col-4">
                        <label><strong>Días a Pagar</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoDiasPagar" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>
                <br />
                <div style="text-align:center">
                    <label><strong>PERIODO CORTE DE NÓMINA</strong></label>
                </div>
                <div class="row">
                    <div class="col-6">
                        <label><strong>Fecha Inicio</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputNominaEmpleadoFechaInicio" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Fin</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputNominaEmpleadoFechaCorte" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>


                @*<br />
                <hr />
                <div style="text-align:center">
                    <label><strong>INGRESOS ADICIONALES</strong></label>
                </div>

                <div class="row">
                    <div class="col-4">
                        <label><strong>Bonos</strong></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoCasino" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-8">
                        <label><strong>Observación</strong></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoPrestamo" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-4">
                        <label><strong>Préstamo</strong></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoPrestamo" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-8">
                        <label><strong>Observación</strong></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoPrestamo" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <br />
                <hr />
                <div style="text-align:center">
                    <label><strong>DESCUENTOS</strong></label>
                </div>





                <div class="row">
                    <div class="col-4">
                        <label><strong>Casino</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoCasino" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-4">
                        <label><strong>Préstamo</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoPrestamo" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
