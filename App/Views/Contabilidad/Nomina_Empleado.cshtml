
@{
    ViewBag.Title = "Nómina Empleado";
}

<script src="~/JsApp/ContratoLaboral.js"></script>
<script src="~/JsApp/NominaEmpleado.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>


<div class="tituloPage">
    <label>NOMINA EMPLEADO</label>
</div>

<div class="grid">
    <table id="gridNominaEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="row" style="margin-top:20px;">
    <div class="col-md-4">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">Total Nóminas</div>
            <div class="card-body">
                <h5 class="card-title" id="dashboardTotalNominas">0</h5>
            </div>
        </div>
    </div>
    <!-- Puedes agregar más KPIs aquí -->
</div>

<div class="row" style="margin-top:30px;">
    <div class="col-md-4">
        <canvas id="graficoIngresos"></canvas>
    </div>
    <div class="col-md-4">
        <canvas id="graficoDescuentos"></canvas>
    </div>
    <div class="col-md-4">
        <canvas id="graficoTotalPago"></canvas>
    </div>
</div>



<div class="modal fade" id="ModalNominaEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalNominaEmpleado"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdNominaEmpleado" hidden></label>
                <div style="text-align:left; margin-bottom:10px">
                    <label><strong>PERIODO DE NÓMINA</strong></label>
                </div>
                <div class="row g-2 g-2">
                    <div class="col-6">
                        <label><strong>Fecha Inicio</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputNominaEmpleadoFechaInicio" name="name" autocomplete="off" style="min-width:100%" onchange="Limpiardatos()" />
                    </div>
                    <div class="col-6">
                        <label><strong>Fecha Fin</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="date" id="InputNominaEmpleadoFechaCorte" name="name" autocomplete="off" style="min-width:100%" onchange="Limpiardatos()" />
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-3">
                        <label><strong>Días a Pagar</strong><label style="color:red" id=""> *</label></label>
                        <input class="form-control" type="number" id="InputNominaEmpleadoDiasPagar" name="name" autocomplete="off" style="min-width:100%" placeholder="0" onchange="Limpiardatos()" />
                    </div>
                    <div class="col-9">
                        <label><strong>Empleado</strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectContratoLaboralEmpleado" style="min-width:100%" onchange="Limpiardatos()"></select>
                    </div>

                </div>

                <div style="text-align:right!important">
                    <br />
                    <button class="btn btn-sm btn-modal-Cancelar" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                    <button style="margin-left:10px!important" class="btn btn-sm btn-modal-guardar" onclick="CargarDatosEmpleadoNomina()">Calcular</button>
                </div>

                <br />
                @*<div class="col-3" id="SelectEstadoNominaEmpleado">
                        <label><strong>Estado</strong></label>
                        <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                    </div>*@


                <div id="datosNominaEmpleado">
                    <div style="text-align:center; font-weight:bold">
                        <label>VALORES NOMINA</label>
                    </div>
                    <br />
                    <div class="row g-2">
                        <div class="col-6">
                            <strong>Empresa/Sucursal:</strong>
                            <label id="txtEmpresaNominaEmpleado"></label>
                        </div>

                        @*contenido parte derecha*@

                        <div class="col-6">
                            <strong>Salario Mensual: </strong>
                            <label id="txtSalarioNominaEmpleado"></label>
                        </div>
                    </div>
                    <br />

                    <div class="row g-3">
                        <div class="col-6">
                            <label><strong>INGRESOS</strong></label>
                            <div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Sueldo</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtSueldoaPagarNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Aux Transporte</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtAuxTransporteNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>HE Diurna</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtHEDiurnaNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>HE Nocturna</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtHENocturnaNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>HE Diurna D/F</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtHEDiurnaDFNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>HE Nocturna D/F</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtHENocturnaDFNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Desembolso Préstamo</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtDesembolsoPrestamoNominaEmpleado"></label>
                                    </div>
                                </div>

                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Otros Ingresos</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtOtrosIngresosNominaEmpleado"></label>
                                    </div>
                                </div>
                                <div class="row g-2" style="color:green">
                                    <div class="col-6">
                                        <strong>TOTAL INGRESOS</strong>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <strong id="txtTotalIngresosNominaEmpleado"></strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @*contenido parte derecha*@

                        <div class="col-6">
                            <label><strong>DESCUENTOS</strong></label>
                            <divay>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Eps</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtEpsNominaEmpleado"></label>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Pensión</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtPensionNominaEmpleado"></label>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Casino</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtCasinoNominaEmpleado"></label>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Cobro Préstamo</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtCobroPrestamoNominaEmpleado"></label>
                                    </div>
                                </div>
                                <div class="row g-2">
                                    <div class="col-6">
                                        <label>Otros Descuentos</label>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <label id="txtOtrosDescuentosNominaEmpleado"></label>
                                    </div>
                                </div>
                                <div class="row g-2" style="color:red">
                                    <div class="col-6">
                                        <strong>TOTAL DESCUENTOS</strong>
                                    </div>
                                    <div class="col-6" style="text-align:right">
                                        <strong id="txtTotalDescuentosNominaEmpleado"></strong>
                                    </div>
                                </div>
                            </divay>
                        </div>
                    </div>

                    <div style="text-align:right !important; font-weight:bold; color:blue">
                        <label>TOTAL A PAGAR</label>
                        <label id="txtTotalPagoNominaEmpleado"></label>
                    </div>

                    <br />
                    <div class="modal-footer" id="BotonesModalNominaEmpleado"></div>
                </div>
            </div>
        </div>
    </div>
</div>




<script>
    $(document).ready(function () {
        ValidarSesion('/Contabilidad/Nomina_Empleado');
        GridNominaEmpleado();
        DGridNominaEmpleado();
        ListaTipoEstado(1);
        ListaContratoLaboralEmpleado();  
    });


    function DGridNominaEmpleado() {
        $.ajax({
            url: '/Contabilidad/Nomina_Empleado/GridNominaEmpleado',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                renderDashboard(data);
                renderCharts(data);
            }
        });
    }

    function renderDashboard(data) {
        // Aquí puedes mostrar totales, promedios, etc. según los datos recibidos
        // Ejemplo: mostrar total de nóminas procesadas
        $('#dashboardTotalNominas').text(data.length);
    }

    function renderCharts(data) {
        // Procesar datos para los gráficos
        const labels = data.map(x => x.NombreEmpleado);
        const ingresos = data.map(x => x.TotalIngresos);
        const descuentos = data.map(x => x.TotalDescuentos);
        const totalPago = data.map(x => x.TotalPago);

        // Gráfico de Ingresos
        new Chart(document.getElementById('graficoIngresos'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Ingresos',
                    data: ingresos,
                    backgroundColor: 'rgba(40, 167, 69, 0.6)'
                }]
            }
        });

        // Gráfico de Descuentos
        new Chart(document.getElementById('graficoDescuentos'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Descuentos',
                    data: descuentos,
                    backgroundColor: 'rgba(220, 53, 69, 0.6)'
                }]
            }
        });

        // Gráfico de Total a Pagar
        new Chart(document.getElementById('graficoTotalPago'), {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: 'Total a Pagar',
                    data: totalPago,
                    backgroundColor: 'rgba(0, 123, 255, 0.6)'
                }]
            }
        });
    }

</script>