
@{
    ViewBag.Title = "Eps";
}

<div class="tituloPage">
    <label>MODULO EPS</label>
</div>

<script src="~/JsApp/Eps.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>


<div class="grid">
    <table id="gridEps" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalEps" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalEps"></div>
            </div>

            <div class="modal-body py-3 px-3">
                <label id="LabelIdEps" hidden></label>

                <div class="row g-2">
                    <div>
                        <label><strong>Nombre Eps</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <input class="form-control" type="text" id="InputNombreEps" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-3" id="SelectEstadoEps">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2" id="BotonesModalEps"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Eps');
        GridEps();
        ListaTipoEstado(1);
    });
</script>