
@{
    ViewBag.Title = "Eps";
}

<div class="tituloPage">
    <label>MODULO EPS</label>
</div>

<script src="~/JsApp/Eps.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>


<div class="grid">
    <table id="gridEps" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalEps" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalEps"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdEps" hidden></label>                
                <div>
                    <label><strong>Nombre </strong><label style="color:red"> *</label></label>
                    <input class="form-control" type="text" id="InputNombreEps" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="col-3" id="SelectEstadoEps">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>                              
            </div>
            <div class="modal-footer" id="BotonesModalEps">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Eps');
        GridEps();
        ListaTipoEstado(1);
    });
</script>