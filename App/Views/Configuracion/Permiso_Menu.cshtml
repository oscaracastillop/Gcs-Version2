
@{
    ViewBag.Title = "Módulo Permiso Menú";
}


<script src="~/JsApp/PermisoMenu.js"></script>
<script src="~/JsApp/Usuario.js"></script>



<div class="tituloPage">
    <label>MODULO PERMISO MENU</label>
</div>

<div class="grid">
    <table id="gridPermisoMenu" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalPermisoMenu" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalPermisoMenu"></div>
            </div>

            <div class="modal-body py-3 px-3">
                <label id="LabelIdPermisoMenu" hidden></label>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Usuario</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-person"></i></span>
                            <select class="form-control" id="SelectUsuario"></select>
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Menú</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-card-list"></i></span>
                            <select class="form-control" id="SelectMenu"></select>
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-3">
                        <label><strong>Ver</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstadoPermisoMenu">
                                <option value="2">Inactivo</option>
                                <option value="1" selected>Activo</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2" id="BotonesModalPermisoMenu"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Permiso_Menu');
        GridPermisoMenu();
        ListaUsuario();
        ListaPermisoMenu();
    });
</script>