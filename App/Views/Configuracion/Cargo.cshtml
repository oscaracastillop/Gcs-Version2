
@{
    ViewBag.Title = "Cargo";
}

<script src="~/JsApp/Cargo.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>

<div class="tituloPage">
    <label>MODULO CARGO</label>
</div>

<div class="grid">
    <table id="gridCargo" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>


<div class="modal fade" id="ModalCargo" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalCargo"></div> 
            </div>

           
            <div class="modal-body py-3 px-3">
                <label id="LabelIdCargo" hidden></label>

                <div class="row g-2">
                    <div>
                        <label><strong>Nombre</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <input class="form-control" type="text" id="InputNombreCargo" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-3" id="SelectEstadoCargo">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="modal-footer py-2" id="BotonesModalCargo"></div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Cargo');
        GridCargo();
        ListaTipoEstado(1);
    });
</script>