
@{
    ViewBag.Title = "Banco";
}

<script src="~/JsApp/Banco.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>

<div class="tituloPage">
    <label>MODULO BANCO</label>
</div>


<div class="grid">
    <table id="gridBanco" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>


<!-- Modal Banco-->
<div class="modal fade" id="ModalBanco" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalBanco"></div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdBanco" hidden></label>

                <div class="row g-2">
                    <div>
                        <label><strong>Nombre</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <input class="form-control" type="text" id="InputNombreBanco" autocomplete="off" />
                        </div>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-3" id="SelectEstadoBanco">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Footer -->
            <div class="modal-footer py-2" id="BotonesModalBanco"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Banco');
        GridBanco();
        ListaTipoEstado(1);
    });
</script>