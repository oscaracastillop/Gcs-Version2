
@{
    ViewBag.Title = "Tipo Hora Extra";
}

<script src="~/JsApp/TipoEstado.js"></script>
<script src="~/JsApp/TipoHoraExtra.js"></script>

<div class="tituloPage">
    <label>MODULO TIPO HORA EXTRA</label>
</div>

<div class="grid">
    <table id="gridTipoHoraExtra" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalTipoHoraExtra" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalTipoHoraExtra"></div>
            </div>

            <div class="modal-body py-3 px-3">
                <label id="LabelIdTipoHoraExtra" hidden></label>

                <div class="row g-2">
                    <div class="col-9">
                        <label><strong>Nombre Hora Extra</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <input class="form-control" type="text" id="InputNombreTipoHoraExtra" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-3">
                        <label><strong>Porcentaje</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-percent"></i></span>
                            <input class="form-control" type="number" id="InputPorcentajeTipoHoraExtra" autocomplete="off" placeholder="0"/>
                        </div>
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-3" id="SelectEstadoTipoHoraExtra">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer py-2" id="BotonesModalTipoHoraExtra"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Tipo_Hora_Extra');
        GridTipoHoraExtra();
        ListaTipoEstado(1);
    });
</script>