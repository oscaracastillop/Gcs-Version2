
@{
    ViewBag.Title = "Tipo Hora Extra";
}

<h6>Módulo Tipo Hora Extra</h6>

<div class="grid">
    <table id="gridTipoHoraExtra" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalTipoHoraExtra" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalTipoHoraExtra"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdTipoHoraExtra" hidden></label>               
                <div class="row">
                    <div class="col-7">
                        <label><strong>Nombre </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="text" id="InputNombreTipoHoraExtra" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-5">
                        <label><strong>Porcentaje </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="number" id="InputPorcentajeTipoHoraExtra" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>                                
                <div class="col-3" id="SelectEstadoTipoHoraExtra">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
            </div>

            <div class="modal-footer" id="BotonesModalTipoHoraExtra">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Configuracion/Tipo_Hora_Extra');
        GridTipoHoraExtra();
        ListaTipoEstado(1);
    });
</script>