
@{
    ViewBag.Title = "Inicio";
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2"></script>

<div class="tituloPage">
    <label>BIENVENIDO ESTIMADO USUARIO</label>
</div>
<br />
<div class="">
    <div class="grid">
        <br />
        <div class="row ">
            <label><strong>ESTADISTICAS COTIZACIONES</strong></label>
            <div class="col-md-4 Centrar-Objeto Centrar-Texto">
                <canvas id="graficoCotizacionesPorEstado" style="max-width: 100%; max-height: 200px !important;"></canvas>
            </div>
            <div class="col-md-8">
                <canvas id="graficoEscalaCotizaciones" style="max-width: 100%; max-height: 300px !important;"></canvas>
            </div>
        </div>
    </div>
</div>




<script>
    $(document).ready(function () {

        $.getJSON('/Cotizacion/GetDatosGraficosCotizacion', function (data) {
            // --- Gráfico de Círculo (Doughnut) por Estado ---
            var estadoLabels = data.porEstado.map(x => x.Estado);
            var estadoData = data.porEstado.map(x => x.Cantidad);
            var estadoTotal = estadoData.reduce((a, b) => a + b, 0);

            new Chart(document.getElementById('graficoCotizacionesPorEstado'), {
                type: 'doughnut',
                data: {
                    labels: estadoLabels,
                    datasets: [{
                        data: estadoData,
                        backgroundColor: ['#36A2EB', '#FF6384', '#FFCE56', '#4BC0C0']
                    }]
                },
                options: {
                    plugins: {
                        datalabels: {
                            color: '#222',
                            font: { weight: 'bold' },
                            formatter: function (value) {
                                let porcentaje = estadoTotal > 0 ? (value / estadoTotal * 100) : 0;
                                return porcentaje.toFixed(1) + '%';
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });

            // --- Gráfico de Barras por Mes ---
            var meses = ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'];
            var mesLabels = data.porMes.map(x => {
                var partes = x.Mes.split('-');
                var anio = partes[0];
                var mes = parseInt(partes[1], 10);
                return meses[mes - 1] + ' ' + anio;
            });
            var mesData = data.porMes.map(x => x.Cantidad);
            var mesTotal = mesData.reduce((a, b) => a + b, 0);

            new Chart(document.getElementById('graficoCotizacionesPorMes'), {
                type: 'bar',
                data: {
                    labels: mesLabels,
                    datasets: [{
                        label: 'Cotizaciones',
                        data: mesData,
                        backgroundColor: 'red',
                        categoryPercentage: 0.7,
                        barPercentage: 0.9
                    }]
                },
                options: {
                    plugins: {
                        datalabels: {
                            color: '#222',
                            font: { weight: 'bold', size: '10' },
                            anchor: 'end',
                            align: 'top',
                            formatter: function (value) {
                                let porcentaje = mesTotal > 0 ? (value / mesTotal * 100) : 0;
                                return porcentaje.toFixed(1) + '%';
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });

            // --- Gráfico de Línea (Escala) por Mes ---
            var maxIndex = mesData.indexOf(Math.max(...mesData));
            var pointColors = mesData.map((v, i) => i === maxIndex ? 'green' : '#36A2EB');

            new Chart(document.getElementById('graficoEscalaCotizaciones'), {
                type: 'line',
                data: {
                    labels: mesLabels,
                    datasets: [{
                        label: 'Cotizaciones x Mes',
                        data: mesData,
                        borderColor: '#36A2EB',
                        backgroundColor: 'rgba(54,162,235,0.1)',
                        fill: true,
                        tension: 0.3,
                        pointBackgroundColor: pointColors,
                        pointBorderColor: '#fff',
                        pointRadius: 4
                    }]
                },
                options: {
                    plugins: {
                        title: {
                            display: true,
                            text: 'Evolución de Cotizaciones',
                            padding: { bottom: 10 },
                            font: { size: 16, weight: 'bold' }
                        },
                        datalabels: {
                            display: false // Oculta los datalabels para no saturar la línea
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            title: {
                                display: true,
                                text: 'Cantidad'
                            }
                        },
                        x: {
                            title: {
                                display: true,
                                text: 'Mes/Año'
                            }
                        }
                    }
                },
                plugins: [ChartDataLabels]
            });
        });

    });
</script>


