
@{
    ViewBag.Title = "Inicio";
}

<h6><Strong>Bienvenido Estimado Usuario</Strong></h6>
<br />

<div class="row" style="margin-left:15px; border:none">
    <div class="card" id="CardDatosEmpresa" style="width:500px; border:none"></div>
</div>
<br />
<div class="row" style="margin-left:15px">
    <div class="card" style="width:150px; padding:0px !important; margin:15px">
        <div style="background-color:orangered; text-align:center; min-width:100%">
            <i class="card-img-top bi-person-walking" style="font-size:4rem; color:white"></i>
        </div>
        <div class="card-body" style="text-align:center">
            <h6 class="card-title" id="NombreEmpresa"><strong>Clientes</strong></h6>
            <h3 class="card-text" style="font-weight:bold; color:green">150</h3>
            <label>Activos: <label></label>40</label>
            <label>In-Activos: <label style="color:red; font-weight:bold">10</label></label>
            @*<small>Total Empleados Creados en el Sistema</small>*@
            @*<br />
                <br />
                <a href="/Empleado" class="btn btn-nuevo-datatable">Ir a Empleados</a>*@
        </div>
    </div>
    <div class="card" style="width:150px; padding:0px !important; margin:15px">
        <div style="background-color: orangered; text-align: center; min-width: 100%">
            <i class="card-img-top bi-houses" style="font-size:4rem; color:white"></i>
        </div>
        <div class="card-body" style="text-align:center">
            <h6 class="card-title" id="NombreEmpresa"><strong>Sucursales</strong></h6>
            <h3 class="card-text" style="font-weight:bold; color:green">8</h3>
            <label>Activos: <label></label>40</label>
            <label>In-Activos: <label style="color:red; font-weight:bold">10</label></label>
            @*<small>Total Sucursales Creadas en el Sistema</small>*@
            @*<br />
                <br />
                <a href="#" class="btn btn-nuevo-datatable">Ir a Sucursales</a>*@
        </div>
    </div>

    <div class="card" style="width:150px; padding:0px !important; margin:15px">
        <div style="background-color:orangered; text-align:center; min-width:100%">
            <i class="card-img-top bi-people" style="font-size:4rem; color:white"></i>
        </div>
        <div class="card-body" style="text-align:center">
            <h6 class="card-title" id="NombreEmpresa"><strong>Empleados</strong></h6>
            <h3 class="card-text" style="font-weight:bold; color:green">50</h3>
            <label>Activos: <label></label>40</label>
            <label>In-Activos: <label style="color:red; font-weight:bold">10</label></label>

            @*<small>Total Empleados Creados en el Sistema</small>*@
            @*<br />
                <br />
                <a href="/Empleado" class="btn btn-nuevo-datatable">Ir a Empleados</a>*@
        </div>
    </div>

    <div class="card" style="width:150px; padding:0px !important; margin:15px">
        <div style="background-color:orangered; text-align:center; min-width:100%">
            <i class="card-img-top bi-boxes" style="font-size:4rem; color:white"></i>
        </div>
        <div class="card-body" style="text-align:center">
            <h6 class="card-title" id="NombreEmpresa"><strong>Productos</strong></h6>
            <h3 class="card-text" style="font-weight:bold; color:green">150</h3>
            <label>Activos: <label></label>40</label>
            <label>In-Activos: <label style="color:red; font-weight:bold">10</label></label>
            @*<small>Total Empleados Creados en el Sistema</small>*@
            @*<br />
                <br />
                <a href="/Empleado" class="btn btn-nuevo-datatable">Ir a Empleados</a>*@
