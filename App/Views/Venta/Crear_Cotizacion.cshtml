
@{
    ViewBag.Title = "Crear Cotizacion";
}

<script src="~/JsApp/Categoria.js"></script>
<script src="~/JsApp/Cliente.js"></script>
<script src="~/JsApp/Cotizacion.js"></script>
<script src="~/JsApp/DetalleCotizacion.js"></script>
<script src="~/JsApp/Producto.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>




<div class="tituloPage">
    <label>MODULO CREAR COTIZACION</label>
</div>
<br />

<div>
    <!-- Cliente -->
    <div class="row g-2">
        <div class="col-6">
            <label><strong>Cliente </strong><label style="color:red"> *</label></label>
            <div class="input-group custom-input">
                <span class="input-group-text icon-highlight"><i class="bi bi-person-fill"></i></span>
                <select class="form-control" id="SelectCliente"></select>
            </div>
        </div>
    </div>

    <!-- Categoría y Producto -->
    <div class="row g-2">
        <div class="col-6">
            <label><strong>Categoría</strong></label>
            <div class="input-group custom-input">
                <span class="input-group-text icon-highlight"><i class="bi bi-tags-fill"></i></span>
                <select class="form-control" id="SelectCategoria" onchange="ListaProductoxIdCategoria($('#SelectCategoria').val())"></select>
            </div>
        </div>
        <div class="col-6">
            <label><strong>Producto y/o Servicio</strong><label style="color:red"> *</label></label>
            <div class="input-group custom-input">
                <span class="input-group-text icon-highlight"><i class="bi bi-basket-fill"></i></span>
                <select class="form-control" id="SelectProductoxIdCategoria" disabled></select>
            </div>
        </div>
    </div>

    <!-- Cantidad / Precio / IVA -->
    <div class="row g-2">
        <div class="col-2">
            <label><strong>Cantidad</strong></label>
            <div class="input-group custom-input">
                <span class="input-group-text icon-highlight"><i class="bi bi-123"></i></span>
                <input class="form-control" type="number" id="InputTCantidadProdDetCot" autocomplete="off" />
            </div>
        </div>
        <div class="col-2">
            <label><strong>Precio Unitario</strong></label>
            <div class="input-group custom-input">
                <span class="input-group-text icon-highlight"><i class="bi bi-currency-dollar"></i></span>
                <input class="form-control" type="number" id="InputTPrecioUnitarioProdDetCot" autocomplete="off" />
            </div>
        </div>
        <div class="col-2">
            <label><strong>% Iva</strong></label>
            <div class="input-group custom-input">
                <span class="input-group-text icon-highlight"><i class="bi bi-percent"></i></span>
                <input class="form-control" type="number" id="InputTPorcIvaProdDetCot" autocomplete="off" />
            </div>
        </div>
    </div>

    <br />

    <!-- Botones -->
    <div>
        <button class="btn btn-modal-Cancelar btn-sm" onclick="BorrarTProductoListaDetCot()">
            Borrar Lista
        </button>
        <button class="btn btn-modal-guardar btn-sm" onclick="AgregarTProductoListaDetCot()">
            Agregar a la Lista
        </button>
    </div>
</div>

<br />
<label style="text-align:center; font-weight:bold">DETALLE COTIZACIÓN</label>
<br />
<div class="grid">
    <table id="gridTemporalDetalleCotizacion" class="table nowrap cell-border table-striped" style="width: 100%;"></table>
</div>

<br />
<div>
    <a href="/Venta/Cotizacion" class="btn btn-sm btn-modal-Cancelar">Cancelar</a>
    <button class="btn btn-modal-guardar btn-sm" onclick="CrearCotizacion()">Crear Cotización</button>
</div>






<script>
    $(document).ready(function () {
        ValidarSesion('/Venta/Cotizacion');
        //GridEntradaAlmacen();
        ListaTipoEstado(1);
        ListaCategoria();
        ListaCliente();
        //ModalCotizacion('C');
        GridTDetalleCotizacion();
    });
</script>

