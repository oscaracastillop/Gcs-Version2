
@{
    ViewBag.Title = "Cliente";
}

<script src="~/JsApp/Ciudad.js"></script>
<script src="~/JsApp/Cliente.js"></script>
<script src="~/JsApp/FormaPago.js"></script>
<script src="~/JsApp/PlazoPago.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>
<script src="~/JsApp/TipoDocumento.js"></script>

<div class="tituloPage">
    <label>MODULO CLIENTE</label>
</div>


<div class="">
    <div class="grid">
        <table id="gridCliente" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
    </div>
</div>

<!-- Modal Cliente-->
<div class="modal fade" id="ModalCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalCliente"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdCliente" hidden></label>

                <!-- Nombre -->
                <div>
                    <label><strong>Nombre </strong><label style="color:red"> *</label></label>
                    <div class="input-group custom-input">
                        <span class="input-group-text icon-highlight"><i class="bi bi-person-fill"></i></span>
                        <input class="form-control" type="text" id="InputNombreCliente" autocomplete="off" />
                    </div>
                </div>

                <div class="row g-2">
                    <!-- Documento -->
                    <div class="col-6">
                        <label><strong>Documento </strong><label style="color:red"> *</label></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <select class="form-control" id="SelectTipoDocumento"></select>
                        </div>
                    </div>

                    <!-- Identificación -->
                    <div class="col-6">
                        <label><strong>Identificación </strong><label style="color:red"> *</label></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-credit-card-2-front"></i></span>
                            <input class="form-control" type="text" id="InputIdentificacionCliente" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <!-- Email -->
                    <div class="col-6">
                        <label><strong>Email</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-envelope-fill"></i></span>
                            <input class="form-control" type="text" id="InputEmailCliente" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Contacto -->
                    <div class="col-6">
                        <label><strong>Nombre Contacto</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person-badge"></i></span>
                            <input class="form-control" type="text" id="InputContactoCliente" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <!-- Teléfono -->
                    <div class="col-6">
                        <label><strong>Teléfono</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-telephone-fill"></i></span>
                            <input class="form-control" type="text" id="InputTelefonoCliente" maxlength="13" placeholder="(ind ciudad) + # Telefónico" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Celular -->
                    <div class="col-6">
                        <label><strong>Celular</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-phone-fill"></i></span>
                            <input class="form-control" type="text" id="InputCelularCliente" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <!-- Forma de Pago -->
                    <div class="col-6">
                        <label><strong>Forma de Pago</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-cash-stack"></i></span>
                            <select class="form-control" id="SelectFormaPago"></select>
                        </div>
                    </div>

                    <!-- Plazo de Pago -->
                    <div class="col-6">
                        <label><strong>Plazo de Pago</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-clock-history"></i></span>
                            <select class="form-control" id="SelectPlazoPago"></select>
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <!-- Dirección -->
                    <div class="col-6">
                        <label><strong>Dirección</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-house-door-fill"></i></span>
                            <input class="form-control" type="text" id="InputDireccionCliente" autocomplete="off" />
                        </div>
                    </div>

                    <!-- Ciudad -->
                    <div class="col-6">
                        <label><strong>Ciudad </strong><label style="color:red"> *</label></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-geo-alt-fill"></i></span>
                            <select class="form-control" id="SelectCiudad"></select>
                        </div>
                    </div>
                </div>

                <!-- Descripción -->
                <div class="row g-2">
                    <div class="col-12">
                        <label><strong>Descripción</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-card-text"></i></span>
                            <input type="text" id="InputDescripcionCliente" class="form-control" />
                        </div>
                    </div>
                </div>

                <!-- Estado -->
                <div class="col-3" id="SelectEstadoCliente">
                    <label><strong>Estado</strong></label>
                    <div class="input-group custom-input">
                        <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                        <select class="form-control" id="SelectEstado"></select>
                    </div>
                </div>
            </div>

            <div class="modal-footer" id="BotonesModalCliente"></div>
        </div>
    </div>
</div>

<div class="modal-dialog modal-lg" id="ModalVerCliente">...</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Venta/Cliente');
        GridCliente();
        ListaTipoDocumento(2);
        ListaTipoEstado(1);
        ListaCiudad();
        ListaFormaPago();
        ListaPlazoPago();
    });

    const inputCelular = document.getElementById('InputCelularCliente');
    const inputTelefono = document.getElementById('InputTelefonoCliente');

    inputCelular.addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, ''); // Eliminar caracteres no numéricos
        if (value.length > 3) {
            value = value.substring(0, 3) + ' ' + value.substring(3);
        }
        if (value.length > 7) {
            value = value.substring(0, 11);
        }
        e.target.value = value;
    });

    inputTelefono.addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, ''); // Eliminar caracteres no numéricos
        if (value.length > 3) {
            value = '(' + value.substring(0, 3) + ')' + ' ' + value.substring(3);
        }
        if (value.length > 7) {
            value = value.substring(0, 13);
        }
        e.target.value = value;
    });

</script>

