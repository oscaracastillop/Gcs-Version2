
@{
    ViewBag.Title = "Cliente";
}

<h6>MODULO CLIENTE</h6>
<div class="">
    <div class="grid">
        <table id="gridCliente" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
    </div>   
</div>

<!-- Modal Cliente-->
<div class="modal fade" id="ModalCliente" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalCliente"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdCliente" hidden></label>
                <div>
                    <label><strong>Nombre </strong><label style="color:red"> *</label></label>
                    <input class="form-control" type="text" id="InputNombreCliente" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="row">
                    <div class="col-6">
                        <label><strong>Documento </strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectTipoDocumento" style="min-width:100%"></select>
                    </div>
                    <div class="col-6">
                        <label><strong>Identificación </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="text" id="InputIdentificacionCliente" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <label><strong>Email</strong></label>
                        <input class="form-control" type="text" id="InputEmailCliente" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Nombre Contacto</strong></label>
                        <input class="form-control" type="text" id="InputContactoCliente" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <label><strong>Teléfono</strong></label>
                        <input class="form-control" type="text" id="InputTelefonoCliente" name="name" autocomplete="off" style="min-width:100%" maxlength="13" placeholder="(ind ciudad) + # Telefónico" />
                    </div>
                    <div class="col-6">
                        <label><strong>Celular</strong></label>
                        <input class="form-control" type="text" id="InputCelularCliente" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <label><strong>Forma de Pago</strong></label>
                        <select class="form-control" id="SelectFormaPago"></select>
                    </div>
                    <div class="col-6">
                        <label><strong>Plazo de Pago</strong></label>
                        <select class="form-control" id="SelectPlazoPago"></select>
                    </div>
                </div>

                <div class="row">
                    <div class="col-6">
                        <label><strong>Dirección</strong></label>
                        <input class="form-control" type="text" id="InputDireccionCliente" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-6">
                        <label><strong>Ciudad </strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectCiudad" style="min-width:100%"></select>
                    </div>
                </div>
                <div class="row">
                    <div class="col-12">
                        <label><strong>Descripción</strong></label>
                        <textarea id="InputDescripcionCliente" class="form-control" style="min-width:100%" rows="3"></textarea>
                    </div>
                </div>
                <div class="col-3" id="SelectEstadoCliente">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
                <br />
                <label style="color: red">Los campos con * son obligatorios</label>
            </div>

            <div class="modal-footer" id="BotonesModalCliente">
            </div>
        </div>
    </div>
</div>

<div class="modal-dialog modal-lg" id="ModalVerCliente">...</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Venta/Cliente');
        GridCliente();
        ListaTipoDocumento(2);
        ListaTipoEstado(1);
        ListaCiudad();
        ListaFormaPago();
        ListaPlazoPago();
    });

    const inputCelular = document.getElementById('InputCelularCliente');
    const inputTelefono = document.getElementById('InputTelefonoCliente');

    inputCelular.addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, ''); // Eliminar caracteres no numéricos
        if (value.length > 3) {
            value = value.substring(0, 3) + ' ' + value.substring(3);
        }
        if (value.length > 7) {
            value = value.substring(0, 11);
        }
        e.target.value = value;
    });

    inputTelefono.addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, ''); // Eliminar caracteres no numéricos
        if (value.length > 3) {
            value = '(' + value.substring(0, 3) + ')' + ' ' + value.substring(3);
        }
        if (value.length > 7) {
            value = value.substring(0, 13);
        }
        e.target.value = value;
    });

</script>

