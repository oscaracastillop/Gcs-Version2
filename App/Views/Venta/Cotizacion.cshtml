                        <h4 id="clienteMasReciente" class="fw-bold text-truncate">—</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4 mb-3">
    <div class="card-header bg-azul">Gráfico: Total Cotizaciones Últimos 12 Meses</div>
    <div class="card-body">
        <canvas id="graficoCotizaciones" height="100"></canvas>
    </div>
</div>




