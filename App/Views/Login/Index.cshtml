
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="contenedor-principal" style="">
    <div class="Centrar-Texto">
        <label class="Titulo-Login Centrar-Texto"><strong>Sofia</strong></label>

    </div>
    <div class="Centrar-Texto Titulo-Login2">
        <label style="color:white; font-size:10px">Software Administrativo<span style="font-size:8px; color:white">&nbsp;&nbsp; V 1.0</span></label>
    </div>
    <div class="Tabla-Login">
        <table class="table table-borderless">
            <tr>
                <td><h4 class="Centrar-Texto" style="color:white"><strong>Inicio Sesión</strong></h4></td>
            </tr>
            <tr>
                <td><input class="form-control Centrar-Objeto" type="text" name="name" id="InputUsuario" value="" placeholder="Usuario" autocomplete="off" /></td>
            </tr>
            <tr>
                <td><input class="form-control Centrar-Objeto" type="password" name="name" id="InputPassword" value="" placeholder="Contraseña" autocomplete="off" /></td>
            </tr>
            @*<tr>
                <td align="center">
                    <input type="checkbox" name="name" id="CheckMostrarPassword" value="" />
                    <label style="color:white; font-size:10px">Mostrar Contraseña</label>
                </td>
            </tr>*@
        </table>
        <div class="Centrar-Texto">
            <button class="btn btn-login-ingresar" style="min-width:180px!important;" onclick="Ingresar()"><i class="bi-person-workspace"></i> Ingresar</button>
        </div>
        <div class="Centrar-Texto" style="margin-top:10px;">            
            <button class="btn btn-login-recuperarpass" disabled><i class="bi-exclamation-diamond"></i> Recuperar Contraseña</button>
        </div>
    </div>
</div>




<script>
    $(document).ready(function () {
        $('#CheckMostrarPassword').click(function () {
            if ($('#CheckMostrarPassword').is(':checked')) {
                $('#InputPassword').attr('type', 'text');
            } else {
                $('#InputPassword').attr('type', 'password');
            }
        });
    });
</script>