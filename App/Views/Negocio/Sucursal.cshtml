@{
    ViewBag.Title = "Sucursal";
}


<script src="~/JsApp/Ciudad.js"></script>
<script src="~/JsApp/Sucursal.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>


<div class="tituloPage">
    <label>MODULO SUCURSAL</label>
</div>

<div class="">
    <div class="grid">
        <table id="gridSucursal" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
    </div>
</div>


<!-- Modal Sucursal-->
<div class="modal fade" id="ModalSucursal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalSucursal"></div> <!-- tamaño original -->
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdSucursal" hidden></label>

                <!-- Nombre -->
                <div>
                    <label><strong>Nombre Sucursal</strong><span class="text-danger">*</span></label>
                    <div class="input-group custom-input">
                        <span class="input-group-text icon-highlight"><i class="bi bi-shop"></i></span>
                        <input class="form-control" type="text" id="InputNombreSucursal" autocomplete="off" />
                    </div>
                </div>


                <!-- Email, Teléfono, Celular -->
                <div class="row g-2">
                    <div class="col-4">
                        <label><strong>Email</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-envelope"></i></span>
                            <input class="form-control" type="text" id="InputEmailSucursal" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Teléfono</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-telephone"></i></span>
                            <input class="form-control" type="text" id="InputTelefonoSucursal" maxlength="13" placeholder="(ind ciudad) + # Telefónico" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Celular</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-phone"></i></span>
                            <input class="form-control" type="text" id="InputCelularSucursal" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <!-- Dirección y Ciudad -->
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Dirección</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-geo-alt"></i></span>
                            <input class="form-control" type="text" id="InputDireccionSucursal" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Ciudad </strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-geo"></i></span>
                            <select class="form-control" id="SelectCiudad"></select>
                        </div>
                    </div>
                </div>


                <!-- Descripción -->
                <div class="row g-2">
                    <div class="col-5">
                        <label><strong>Contacto</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-person"></i></span>
                            <input class="form-control" type="text" id="InputContactoSucursal" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Descripción Sucursal</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-earmark-text"></i></span>
                            <input type="text" id="InputDescripcionSucursal" class="form-control" />
                        </div>
                    </div>
                    <!-- Estado -->
                    <div class="col-3" id="SelectEstadoSucursal">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>


                
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2" id="BotonesModalSucursal"></div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Negocio/Sucursal');
        GridSucursal();
        ListaTipoEstado(1);
        ListaCiudad();
    });

    const inputCelular = document.getElementById('InputCelularSucursal');
    const inputTelefono = document.getElementById('InputTelefonoSucursal');

    inputCelular.addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, ''); // Eliminar caracteres no numéricos
        if (value.length > 3) {
            value = value.substring(0, 3) + ' ' + value.substring(3);
        }
        if (value.length > 7) {
            value = value.substring(0, 11);
        }
        e.target.value = value;
    });

    inputTelefono.addEventListener('input', function (e) {
        let value = e.target.value.replace(/\D/g, ''); // Eliminar caracteres no numéricos
        if (value.length > 3) {
            value = '(' + value.substring(0, 3) + ')' + ' ' + value.substring(3);
        }
        if (value.length > 7) {
            value = value.substring(0, 13);
        }
        e.target.value = value;
    });
</script>



