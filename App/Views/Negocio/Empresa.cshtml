
@{
    ViewBag.Title = "Empresa";
}

<h6><strong>Modulo Empresa</strong></h6>

<div class="grid" style="color:lightgray">

    <table id="gridEmpresa" class="table" style="width: 150%;"></table>
</div>

<!-- Modal Empresa-->
<div class="modal fade" id="ModalEmpresa" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalEmpresa"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdEmpresa" hidden></label>
                <div>
                    <label><strong>Nombre </strong><label style="color:red"> *</label></label>
                    <input class="form-control" type="text" id="InputNombreEmpresa" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="row">
                    <div class="col-5">
                        <label><strong>Documento </strong><label style="color:red"> *</label></label>
                        <select class="form-control" id="SelectTipoDocumento" style="min-width:100%"></select>
                    </div>
                    <div class="col-7">
                        <label><strong>Identificación </strong><label style="color:red"> *</label></label>
                        <input class="form-control" type="text" id="InputIdentificacionEmpresa" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div>
                    <label><strong>Email</strong></label>
                    <input class="form-control" type="text" id="InputEmailEmpresa" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="row">
                    <div class="col-5">
                        <label><strong>Teléfono</strong></label>
                        <input class="form-control" type="text" id="InputTelefonoEmpresa" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                    <div class="col-7">
                        <label><strong>Contacto</strong></label>
                        <input class="form-control" type="text" id="InputContactoEmpresa" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

                <div>
                    <label><strong>Dirección</strong></label>
                    <input class="form-control" type="text" id="InputDireccionEmpresa" name="name" autocomplete="off" style="min-width:100%" />
                </div>
                <div>
                    <label><strong>Ciudad </strong><label style="color:red"> *</label></label>
                    <select class="form-control" id="SelectCiudad" style="min-width:100%"></select>
                </div>
                <div class="col-3" id="SelectEstadoEmpresa">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
                <br />
                <label style="color: red">Los campos con * son obligatorios</label>
            </div>

            <div class="modal-footer" id="BotonesModalEmpresa">
            </div>
        </div>
    </div>
</div>

<!-- Modal logo Empresa-->
<div class="modal fade" id="ModalLogoEmpresa" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title"><label>Logo Empresa</label></div>
            </div>
            <label id="IdEmpresaLogo" hidden></label>
            <label id="NombreLogoActualEmpresa" hidden></label>
            <div class="modal-body" style="text-align:center">
                <div style="text-align:center">
                    <h6><strong id="NombreEmpresaLogo"></strong></h6>
                    <div id="ImagenLogoEmpresa" style="margin-top:10px; text-align:center"></div>
                    <br />
                </div>
                <div style="margin-top:15px">
                    <input type="file" class="form-control" id="inPhotoEmpresa" name="name" aria-describedby="inputGroupFileAddon04" aria-label="Upload" accept="image/*" style="min-width:100%">
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-modal-Cancelar btn-sm" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                <button class="btn btn-modal-guardar btn-sm" type="button" onclick="GuardarLogoEmpresa()">Guardar Imagen</button>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        ValidarSesion('/Negocio/Empresa');
        GridEmpresa();
        ListaTipoDocumento(2);
        ListaTipoEstado(1);
        ListaCiudad();
    });
</script>

