
@{
    ViewBag.Title = "Sucursal Empleado";
}


<script src="~/JsApp/Empleado.js"></script>
<script src="~/JsApp/Empresa.js"></script>
<script src="~/JsApp/Sucursal.js"></script>
<script src="~/JsApp/SucursalEmpleado.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>


<div class="tituloPage">
    <label>MODULO SUCURSAL-EMPLEADO</label>
</div>

<div class="grid">
    <table id="gridSucursalEmpleado" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalCambiarSucursalEmpleado" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title">
                    <label>CAMBIAR SUCURSAL EMPLEADO</label>
                </div>
            </div>
            <div class="modal-body">
                <label id="LabelIdSucursalEmpleadoCambiarSucursal" hidden></label>
                <div>
                    <label><strong>Empleado </strong><label style="color:red" id="">*</label></label>
                    <input class="form-control" type="text" id="InputCambiarSucursalNombreEmpleado" autocomplete="off" style="min-width:100%" disabled />
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Empresa Actual </strong><label style="color:red">*</label></label>
                        <input class="form-control" type="text" id="InputCambiarSucursalEmpresaActual" name="name" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                    <div class="col-6">
                        <label><strong>Sucursal Actual</strong><label style="color:red">*</label></label>
                        <input class="form-control" type="text" id="InputCambiarSucursalSucursalActual" autocomplete="off" style="min-width:100%" disabled />
                    </div>
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Nueva Sucursal</strong><label style="color:red">*</label></label>
                        <select class="form-control" id="SelectSucursalXIdEmpresa" style="min-width:100%"></select>
                    </div>
                    <div class="col-6">
                        <label><strong>Observación</strong></label>
                        <input class="form-control" type="text" id="InputObservacionSE" name="name" autocomplete="off" style="min-width:100%" />
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-modal-Cancelar" data-bs-dismiss="modal" aria-label="Close">Cancelar</button>
                <button type="button" class="btn btn-sm btn-modal-guardar" onclick="CambiarSucursalEmpleado()">Guardar Cambios</button>
            </div>
        </div>
    </div>
</div>


