
@{
    ViewBag.Title = "Inventario";
}

<script src="~/JsApp/Inventario.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="tituloPage">
    <label>MODULO INVENTARIO ALMACEN</label>
</div>

<div class="grid">
    <table id="gridInventario" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>


<div class="container-fluid my-4">

    <h6 class="fw-bold text-center mb-4 text-dark">
        <i class="bi bi-clipboard-data"></i> DASHBOARD DE INVENTARIO
    </h6>

    <style>
        
    </style>
        
    <div class="row g-3" id="cardsResumenInventario">
        <div class="col-md-3">
            <div class="card-resumen bg-azul">
                <div class="card-header">Total Productos</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="totalProductos">0</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-resumen bg-verde">
                <div class="card-header">Valor Total Inventario</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="valorInventario">$ 0</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-resumen bg-rojo">
                <div class="card-header">Productos Bajo Stock</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="productosBajoStock">0</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-resumen bg-morado">
                <div class="card-header">Más Días sin Movimiento</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="productoMasDias" class="fw-bold text-truncate">—</h4>
                        <small id="diasMasSinMovimiento">— días</small>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-stopwatch"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-md-3">
            <div class="card-resumen bg-cyan">
                <div class="card-header">Stock Total</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="stockTotal">0</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-resumen bg-amarillo">
                <div class="card-header">Mayor Stock</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="productoMayorStock" class="fw-bold text-truncate">—</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-arrow-up-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-resumen bg-naranja">
                <div class="card-header">Menor Stock</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="productoMenorStock" class="fw-bold text-truncate">—</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-arrow-down-circle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card-resumen bg-gris">
                <div class="card-header">Más Reciente</div>
                <div class="card-body">
                    <div class="card-texto">
                        <h4 id="productoMasReciente" class="fw-bold text-truncate">—</h4>
                    </div>
                    <div class="card-icono">
                        <i class="bi bi-clock-history"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    $(document).ready(function () {
        ValidarSesion('/Almacen/Inventario');
        GridInventario();
    });
</script>