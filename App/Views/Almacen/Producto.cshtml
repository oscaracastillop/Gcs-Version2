
@{
    ViewBag.Title = "Producto";
}


<script src="~/JsApp/Categoria.js"></script>
<script src="~/JsApp/Producto.js"></script>
<script src="~/JsApp/TipoEstado.js"></script>
<script src="~/JsApp/UnidadMedida.js"></script>

<div class="tituloPage">
    <label>MODULO PRODUCTO</label>
</div>



<div class="grid">
    <table id="gridProducto" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>


<!-- Modal Producto -->
<div class="modal fade" id="ModalProducto" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1"
     aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content shadow-sm rounded-3 border-0">

            <!-- Header -->
            <div class="modal-header text-white header-modal">
                <div class="modal-title" id="TituloModalProducto"></div>
            </div>

            <!-- Body -->
            <div class="modal-body py-3 px-3">
                <label id="LabelIdProducto" hidden></label>

                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Categoría</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-tags-fill"></i></span>
                            <select class="form-control" id="SelectCategoria"></select>
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Nombre</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-box-seam"></i></span>
                            <input class="form-control" type="text" id="InputNombreProducto" autocomplete="off" />
                        </div>
                    </div>
                </div>


                <div class="row g-2">
                    <div class="col-6">
                        <label><strong>Marca</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text"></i></span>
                            <input class="form-control" type="text" id="InputMarcaProducto" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-6">
                        <label><strong>Referencia</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-file-text-fill"></i></span>
                            <input class="form-control" type="text" id="InputReferenciaProducto" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-4">
                        <label><strong>Código</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-qr-code"></i></span>
                            <input class="form-control" type="text" id="InputCodigoProducto" autocomplete="off" />
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Und. Medida</strong><span class="text-danger">*</span></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-basket2-fill"></i></span>
                            <select class="form-control" id="SelectUnidadMedida"></select>
                        </div>
                    </div>
                    <div class="col-4">
                        <label><strong>Stock Mínimo</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-123"></i></span>
                            <input class="form-control" type="text" id="InputStockMinimo" autocomplete="off" />
                        </div>
                    </div>
                </div>

                <div class="row g-2">
                    <div class="col-9">
                        <label><strong>Descripción</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-card-text"></i></span>
                            <input type="text" id="InputDescripcionProducto" class="form-control" />
                        </div>
                    </div>
                    <div class="col-3" id="SelectEstadoProducto">
                        <label><strong>Estado</strong></label>
                        <div class="input-group custom-input">
                            <span class="input-group-text icon-highlight"><i class="bi bi-toggle-on"></i></span>
                            <select class="form-control" id="SelectEstado"></select>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer py-2" id="BotonesModalProducto"></div>
        </div>
    </div>
</div>

<!-- Modal imagen Producto-->
<div class="modal fade" id="ModalImagenProducto" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">

            <!-- Header -->
            <div class="modal-header header-modal">
                <label class="modal-title fw-bold mb-0">IMAGEN PRODUCTO</label>
            </div>

            <!-- Hidden labels -->
            <label id="IdProductoImagen" hidden></label>
            <label id="NombreImagenActualProducto" hidden></label>

            <!-- Body -->
            <div class="modal-body bg-light p-4">
                <!-- Nombre empleado -->
                <div class="text-center mb-3">
                    <h6 class="fw-bold mb-0" id="NombreProductoImagen"></h6>
                </div>

                <!-- Imagen actual -->
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header text-white fw-semibold py-2" style="background-color: #3b5998;">
                        Imagen actual
                    </div>
                    <div class="card-body text-center">
                        <div class="contimg-cambiar-img" id="ImagenProducto"></div>
                    </div>
                </div>

                <!-- Nueva imagen -->
                <div class="card border-0 shadow-sm">
                    <div class="card-header text-white fw-semibold py-2" style="background-color: #3b5998;">
                        Subir nueva imagen
                    </div>
                    <div class="card-body">
                        <input type="file" class="form-control mb-3" id="inPhoto"
                               name="name" accept="image/*"
                               aria-describedby="inputGroupFileAddon04"
                               aria-label="Upload">
                        <!-- Previsualización -->
                        <div id="previewContainer" class="text-center d-none">
                            <p class="fw-semibold">Vista previa:</p>
                            <img id="previewImage" class="img-fluid rounded shadow-sm border" alt="Vista previa">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer bg-light border-0 p-3 d-flex justify-content-between">
                <button type="button" class="btn btn-modal-Cancelar btn-sm" data-bs-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-modal-guardar btn-sm" type="button" onclick="GuardarImagenProducto()">
                    Guardar Imagen
                </button>
            </div>
        </div>
    </div>
</div>




<script>
    // Previsualización de la nueva imagen
    document.getElementById("inPhoto").addEventListener("change", function (event) {
        const file = event.target.files[0];
        const previewContainer = document.getElementById("previewContainer");
        const previewImage = document.getElementById("previewImage");

        if (file) {
            const reader = new FileReader();
            reader.onload = function (e) {
                previewImage.src = e.target.result;
                previewContainer.classList.remove("d-none");
            };
            reader.readAsDataURL(file);
        } else {
            previewContainer.classList.add("d-none");
            previewImage.src = "";
        }
    });

    $(document).ready(function () {
        ValidarSesion('/Almacen/Producto');
        GridProducto();
        ListaTipoEstado(1);
        ListaUnidadMedida();
        ListaCategoria();
    });
</script>
