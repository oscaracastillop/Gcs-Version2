
@{
    ViewBag.Title = "Categoría";
}

<h6>MODULO CATEGORIA</h6>

<div class="grid">
    <table id="gridCategoria" class="table nowrap cell-border table-striped" cellspacing="0" style="width: 100%;"></table>
</div>

<div class="modal fade" id="ModalCategoria" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header header-modal">
                <div class="modal-title" id="TituloModalCategoria"></div>
            </div>
            <div class="modal-body">
                <label id="LabelIdCategoria" hidden></label>
                <div>
                    <label><strong>Nombre </strong><label style="color:red"> *</label></label>
                    <input class="form-control" type="text" id="InputNombreCategoria" autocomplete="off" style="min-width:100%" />
                </div>
                <div class="col-3" id="SelectEstadoCategoria">
                    <label><strong>Estado</strong></label>
                    <select class="form-control" id="SelectEstado" style="min-width:100%"></select>
                </div>
            </div>

            <div class="modal-footer" id="BotonesModalCategoria">
            </div>
        </div>
    </div>
</div>



<script>
    $(document).ready(function () {
        ValidarSesion('/Almacen/Categoria');
        GridCategoria();
        ListaTipoEstado(1);
    });
</script>
